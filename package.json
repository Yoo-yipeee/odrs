{
  "name": "@odrs/core",
  "version": "0.2.0",
  "description": "Open Data Request Specification — validator, renderer and CLI for machine-readable Physical AI data requirements",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "odrs": "./bin/odrs.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./schema": "./spec/v0.1/data-request.schema.json",
    "./spec/*": "./spec/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "spec"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.5.0"
  },
  "keywords": [
    "odrs",
    "physical-ai",
    "robotics",
    "data-request",
    "specification",
    "json-schema"
  ],
  "types": "./src/index.d.ts"
}
